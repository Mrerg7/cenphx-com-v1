---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Acquisition from '../components/Acquisition.astro';
import { SITE, ACQUISITION_MAILTO } from '../config/site';

type Insight = CollectionEntry<'insights'>;

const STREAM_ID = SITE.streamId;
const STREAM_CUSTOMER = SITE.streamHost.split('/')[0];
const POSTER = SITE.ogImage;
const HLS_SRC = `https://${STREAM_CUSTOMER}/${STREAM_ID}/manifest/video.m3u8`;

const faqs = [
  {
    q: `Is ${SITE.domain} for sale?`,
    a: `Yes. ${SITE.domain} is a premium domain name available for acquisition from the owner. Serious buyers can email ${SITE.email}. We respond personally within 1–2 business days.`,
  },
  {
    q: 'What is the asking price?',
    a: `The listed acquisition price is ${SITE.priceDisplay} USD, one-time, with full ownership and a clean title. Email us if you would like to discuss terms.`,
  },
  {
    q: 'How do I buy this domain?',
    a: `Email ${SITE.email} with your offer and timeline. Every transaction is completed through Escrow.com so funds and domain transfer are both protected.`,
  },
  {
    q: 'What does CenPHX mean?',
    a: "CenPHX is Central Phoenix written with the city code PHX. Cen for Central, PHX for Phoenix — six letters that already read as the urban core to anyone who lives inside the Loop 202.",
  },
  {
    q: 'What is the domain designed for?',
    a: 'CenPHX.com is built for a local brand — real estate, hospitality, media, medical, or neighborhood retail in the Central Phoenix core. The hostname carries the geography, so the name needs no explanation.',
  },
  {
    q: 'Is the domain transfer safe?',
    a: 'Yes. Acquisitions are escrow-protected via Escrow.com. The domain has a clean title and transfers to your registrar account, typically within 0–5 business days after cleared payment.',
  },
];

const faqSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const posts = (await getCollection('insights', (entry: Insight): entry is Insight => !entry.data.draft))
  .sort((a: Insight, b: Insight) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout schemas={[faqSchema]}>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="relative bg-mesa-950" aria-label="Hero">
      <div class="stream-hero relative isolate w-full overflow-hidden">
        <div
          class="absolute inset-0 bg-mesa-950 bg-cover bg-center"
          style={`background-image: url('${POSTER}')`}
          aria-hidden="true"
        ></div>
        <video
          id="hero-stream"
          class="absolute inset-0 h-full w-full object-cover"
          poster={POSTER}
          muted
          loop
          playsinline
          autoplay
          preload="auto"
          aria-label="CenPHX Central Phoenix hero video"
        ></video>
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-t from-mesa-950 via-mesa-950/45 to-mesa-950/20 sm:via-mesa-950/55 sm:to-mesa-950/15"
          aria-hidden="true"
        ></div>
        <div class="absolute inset-0 flex items-end">
          <div class="container-narrow w-full pb-8 pt-20 sm:pb-12 sm:pt-20">
            <p class="mb-2 text-[10px] font-semibold uppercase tracking-widestx text-sun-300 sm:mb-3 sm:text-xs">
              Central Phoenix domain for sale · Arizona · PHX
            </p>
            <h1 class="font-display text-5xl font-semibold leading-none text-white sm:text-6xl lg:text-7xl">
              Cen<span class="text-sun-400">PHX</span>
            </h1>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-mesa-100/90 sm:mt-5 sm:text-lg">
              The compact domain for Central Phoenix — city core plus the airport code everyone already knows.
              Offered at {SITE.priceDisplay}.
            </p>
            <div class="mt-5 flex flex-col gap-2 sm:mt-8 sm:flex-row sm:gap-3">
              <a href="#acquisition" class="btn-primary pointer-events-auto">Inquire — {SITE.priceDisplay}</a>
              <a href="#value" class="btn-secondary pointer-events-auto">Why it is valuable</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <script is:inline define:vars={{ HLS_SRC }}>
      (function () {
        const video = document.getElementById('hero-stream');
        if (!(video instanceof HTMLVideoElement)) return;

        const tryPlay = () => {
          video.muted = true;
          video.play().catch(() => {});
        };

        if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = HLS_SRC;
          video.addEventListener('loadeddata', tryPlay, { once: true });
          tryPlay();
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js';
        script.async = true;
        script.onload = () => {
          if (!window.Hls || !window.Hls.isSupported()) return;
          const hls = new window.Hls({ enableWorker: true, maxBufferLength: 10 });
          hls.loadSource(HLS_SRC);
          hls.attachMedia(video);
          hls.on(window.Hls.Events.MANIFEST_PARSED, tryPlay);
        };
        document.head.appendChild(script);
      })();
    </script>

    <section id="place" class="section-padding bg-mesa-50">
      <div class="container-narrow max-w-3xl">
        <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-500">The place</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">Central Phoenix, written the short way</h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-mesa-800 sm:text-base">
          <p>
            Central Phoenix is the part of the city people mean when they say midtown, downtown, Arcadia, and the Camelback corridor.
            It is not a suburb name. It is the core.
          </p>
          <p>
            <strong class="text-mesa-950">CenPHX.com</strong> compresses that geography into six letters: Cen for Central, PHX for Phoenix.
            Locals already say both halves. The domain puts them together.
          </p>
        </div>
      </div>
    </section>

    <section id="value" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-500">The value</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">Why this is the most valuable Central Phoenix name</h2>
        </div>
        <div class="mt-12 grid gap-4 sm:gap-6 md:grid-cols-2">
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-mesa-950">SEO in the letters</h3>
            <p class="mt-3 text-sm leading-relaxed text-mesa-700">
              Searchers type Central Phoenix and PHX. The hostname contains both. Title, H1, and URL all point at the same local query.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-mesa-950">City-code lock</h3>
            <p class="mt-3 text-sm leading-relaxed text-mesa-700">
              PHX is the airport, the weather code, and the shorthand on listings. Pairing it with Central leaves little room for a rival phrase.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-mesa-950">Works across categories</h3>
            <p class="mt-3 text-sm leading-relaxed text-mesa-700">
              Real estate, hospitality, media, medical, and neighborhood retail can all sit under one geographic brand without a forced industry word.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-mesa-950">Short enough to print</h3>
            <p class="mt-3 text-sm leading-relaxed text-mesa-700">
              Six letters on a yard sign, a van, or a maps listing. No explanation required for anyone who lives inside the Loop 202.
            </p>
          </article>
        </div>

        <div class="mt-10 rounded-2xl bg-mesa-950 p-6 text-center sm:p-10">
          <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-400">Asking price</p>
          <p class="mt-3 font-display text-5xl font-semibold text-sun-300 sm:text-6xl">{SITE.priceDisplay}</p>
          <p class="mt-3 text-sm text-mesa-200">A one-time acquisition for the Central Phoenix shorthand.</p>
          <a href="#acquisition" class="btn-primary mt-6">Request terms</a>
        </div>
      </div>
    </section>

    <section id="use" class="section-padding bg-mesa-50">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-500">The use</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">Who this name is for</h2>
          <p class="mt-4 text-sm leading-relaxed text-mesa-800 sm:text-base">
            Operators who need the city core in the URL — not a invented brand that has to be taught. CenPHX is already the map.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-mesa-800 sm:text-base">
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sun-400"></span><span><strong class="text-mesa-950">Real estate</strong> — listings, brokerages, and infill development in the core.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sun-400"></span><span><strong class="text-mesa-950">Hospitality & retail</strong> — a neighborhood name guests can type after dinner.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-sun-400"></span><span><strong class="text-mesa-950">Local media</strong> — a masthead that is the place, not a slogan.</span></li>
          </ul>
        </div>
        <div class="rounded-2xl border border-mesa-200 bg-white p-6 sm:p-8">
          <dl class="space-y-5">
            <div class="flex items-baseline justify-between gap-4 border-b border-mesa-100 pb-4">
              <dt class="text-sm text-mesa-600">Reads as</dt>
              <dd class="font-display text-xl font-semibold text-mesa-950 sm:text-2xl">Central Phoenix</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-mesa-100 pb-4">
              <dt class="text-sm text-mesa-600">Market</dt>
              <dd class="font-display text-xl font-semibold text-mesa-950 sm:text-2xl">Phoenix, AZ</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-mesa-100 pb-4">
              <dt class="text-sm text-mesa-600">Code</dt>
              <dd class="font-display text-xl font-semibold text-mesa-950 sm:text-2xl">PHX</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-mesa-600">Offer</dt>
              <dd class="font-display text-xl font-semibold text-sun-500 sm:text-2xl">{SITE.priceDisplay}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="faq" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-500">FAQ</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">Questions buyers ask</h2>
          <p class="mt-4 text-base leading-relaxed text-mesa-700 sm:text-lg">
            Everything about the offer, the transfer, and the name. Something missing?
            <a
              href={ACQUISITION_MAILTO('Domain Inquiry: CenPHX.com')}
              class="font-medium text-mesa-950 underline decoration-sun-400 underline-offset-4"
            >
              Ask us directly
            </a>.
          </p>
        </div>

        <div class="mx-auto mt-12 max-w-3xl space-y-4">
          {
            faqs.map((item) => (
              <details class="card group">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display text-xl font-semibold text-mesa-950 sm:text-2xl">
                  <span>{item.q}</span>
                  <svg
                    class="mt-1 h-5 w-5 shrink-0 text-sun-500 transition-transform group-open:rotate-45"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-mesa-700 sm:text-base">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {
      posts.length > 0 && (
        <section class="section-padding bg-mesa-50">
          <div class="container-narrow">
            <div class="mx-auto max-w-2xl text-center">
              <p class="text-[11px] font-semibold uppercase tracking-widestx text-sun-500">Insights</p>
              <h2 class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">
                More on Central Phoenix &amp; the name
              </h2>
            </div>
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((post) => (
                <a href={`/insights/${post.slug}/`} class="card group flex flex-col transition hover:-translate-y-1">
                  <p class="text-[11px] font-medium uppercase tracking-widestx text-sun-500">
                    {post.data.pubDate.toISOString().split('T')[0]}
                  </p>
                  <h3 class="mt-3 font-display text-xl font-semibold text-mesa-950 group-hover:text-mesa-700">
                    {post.data.title}
                  </h3>
                  <p class="mt-3 text-sm leading-relaxed text-mesa-700">{post.data.description}</p>
                  <span class="mt-4 text-sm font-medium text-mesa-900">Read more →</span>
                </a>
              ))}
            </div>
            <div class="mt-8 text-center">
              <a href="/insights/" class="btn-outline">All insights</a>
            </div>
          </div>
        </section>
      )
    }

    <Acquisition />
  </main>

  <Footer />
</Layout>
