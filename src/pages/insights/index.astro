---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config/site';

type Insight = CollectionEntry<'insights'>;

const insights = (
  await getCollection('insights', (entry: Insight): entry is Insight => !entry.data.draft)
).sort((a: Insight, b: Insight) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={`Central Phoenix Insights & Domain Branding | ${SITE.domain}`}
  description={`Practical guides on Central Phoenix geography, the PHX code, geo-domain value, and how premium domain acquisitions work — published by the team behind ${SITE.domain}.`}
  canonical="/insights/"
  keywords="Central Phoenix insights, PHX code, geo domain value, Phoenix neighborhoods, domain acquisition, CenPHX"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/insights/' },
  ]}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="border-b border-mesa-200 bg-mesa-950">
      <div class="container-narrow py-16 sm:py-24">
        <p class="text-[11px] font-medium uppercase tracking-widestx text-sun-400">Insights · Phoenix · Domains</p>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-white sm:text-6xl">
          Central Phoenix insights, from {SITE.name}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-mesa-100/90 sm:text-lg">
          Practical, no-fluff guides on the geography and naming the {SITE.domain} domain was built to lead — the
          urban core, the PHX code, and the decisions behind a premium geo domain.
        </p>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            insights.map((post: Insight) => (
              <a href={`/insights/${post.slug}/`} class="card group flex flex-col transition hover:-translate-y-1">
                <p class="text-[11px] font-medium uppercase tracking-widestx text-sun-500">
                  {post.data.pubDate.toISOString().split('T')[0]}
                </p>
                <h2 class="mt-3 font-display text-2xl font-semibold text-mesa-950 group-hover:text-mesa-700">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-mesa-700">{post.data.description}</p>
                <span class="mt-4 text-sm font-medium text-mesa-900">Read more →</span>
              </a>
            ))
          }
        </div>

        <div class="mt-14 rounded-3xl border border-mesa-200 bg-mesa-50 p-6 text-center sm:p-10">
          <p class="text-[11px] font-medium uppercase tracking-widestx text-sun-500">The domain behind the insights</p>
          <p class="mt-3 font-display text-3xl font-semibold text-mesa-950 sm:text-4xl">{SITE.domain}</p>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-mesa-700">
            Central Phoenix compressed into the letters people already use — offered at {SITE.priceDisplay}. Built
            for a local brand that intends to rank, not just open.
          </p>
          <a href="/#acquisition" class="btn-primary mt-6">Make an offer</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
